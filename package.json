{
  "name": "@cleocode/goal",
  "version": "0.9.7",
  "description": "CLEO Goal: persistent, host-verified goal mode for OpenCode 2 (and any harness through cleo-goal tick), with a structured goal contract and a live TUI.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14.0",
    "opencode": ">=2.0.22"
  },
  "scripts": {
    "build": "bun run build:tui && bun run build:cli",
    "build:tui": "bun scripts/build-tui.mjs",
    "check:tui": "bun scripts/build-tui.mjs --check",
    "build:cli": "bun scripts/build-cli.mjs",
    "check:cli": "bun scripts/build-cli.mjs --check",
    "prepublishOnly": "bun run check:tui && bun run check:cli",
    "test": "bun test --timeout 120000",
    "test:host": "bun test test/host --timeout 120000",
    "typecheck": "bun run check:tui && bun run check:cli && tsc --noEmit"
  },
  "devDependencies": {
    "@opencode/client": "2.0.22",
    "@opencode/plugin": "2.0.22",
    "@opencode/theme": "2.0.22",
    "@opentui/core": "0.5.14",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "bin": {
    "cleo-goal": "./dist/cli.js",
    "ocg": "./dist/cli.js"
  },
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "server.ts",
    "tui.tsx",
    "rpc.ts",
    "cli",
    "dist",
    "src",
    "skills",
    "!skills/*/evals",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kryptobaseddev/open-goal.git"
  },
  "homepage": "https://github.com/kryptobaseddev/open-goal#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "goal",
    "goal-mode",
    "autonomous",
    "agent",
    "cleo",
    "cleo-goal",
    "harness"
  ],
  "dependencies": {
    "@opentui/solid": "0.5.14",
    "solid-js": "1.9.15",
    "yaml": "2.8.1"
  },
  "bugs": {
    "url": "https://github.com/kryptobaseddev/open-goal/issues"
  },
  "overrides": {
    "@aws-sdk/client-cognito-identity": "3.1057.0",
    "@aws-sdk/core": "3.978.1",
    "@aws-sdk/credential-provider-cognito-identity": "3.972.71",
    "@aws-sdk/credential-provider-env": "3.972.72",
    "@aws-sdk/credential-provider-http": "3.972.74",
    "@aws-sdk/credential-provider-ini": "3.973.17",
    "@aws-sdk/credential-provider-login": "3.972.79",
    "@aws-sdk/credential-provider-node": "3.972.84",
    "@aws-sdk/credential-provider-process": "3.972.72",
    "@aws-sdk/credential-provider-sso": "3.973.16",
    "@aws-sdk/credential-provider-web-identity": "3.972.78",
    "@aws-sdk/credential-providers": "3.1057.0",
    "@aws-sdk/nested-clients": "3.997.46",
    "@aws-sdk/signature-v4-multi-region": "3.996.47",
    "@aws-sdk/token-providers": "3.1138.0",
    "@aws-sdk/types": "3.974.6",
    "@aws-sdk/util-locate-window": "3.965.10",
    "@aws-sdk/xml-builder": "3.972.41"
  }
}
